void timer2_stop() {        // Stop Timer 2 interrupt
  TIMSK2 &= ~(1 << OCIE2A); // disable timer compare interrupt
  delay(1); // wait until potential in-flight interrupts are finished
}

void lcd_blanks() { lcd.print(F("        ")); }
